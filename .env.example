# Todo esto también se puede cargar desde Configuración en la interfaz (queda en data/config.json y manda sobre este archivo).
# Copiá este archivo a .env y completá tu clave.
ANTHROPIC_API_KEY=sk-ant-...

# Quién sos. Plano te saluda por tu nombre.
PLANO_USUARIO=Martín

# Modelo para la entrevista y el roadmap (donde pesa el criterio). Opus es el default.
PLANO_MODELO=claude-opus-5-5
# Modelo para generar y corregir pantallas del prototipo. Sonnet es el default: la mitad de precio, y la calidad la fijan
# el brief, el verificador y tu revisión. Poné claude-opus-5-5 si querés el mismo modelo en todo.
PLANO_MODELO_PROTOTIPO=claude-sonnet-5-5

# Puerto de la interfaz.
PLANO_PUERTO=4747

# A partir de cuántos tokens de conversación se compacta (los mensajes viejos dejan de mandarse; el Plano queda).
# 40000 es el default y el punto justo: más alto, cada reescritura de caché (tras una hora sin hablar) cuesta proporcional.
PLANO_COMPACTAR=40000
